#!/bin/sh
# 测试用的伪 docker：记录调用到 $DOCKER_LOG，行为由环境变量控制
#   DOCKER_INFO_RC     `docker info` 的退出码（默认 0）
#   DOCKER_NET_EXISTS  1 表示 `docker network inspect` 成功
#   DOCKER_NET_DESC    `docker network inspect -f ...` 的输出
echo "$*" >> "${DOCKER_LOG:-/dev/null}"
case "$1" in
	info) exit "${DOCKER_INFO_RC:-0}" ;;
	network)
		case "$2" in
			inspect)
				[ "${DOCKER_NET_EXISTS:-0}" = 1 ] || exit 1
				[ "$3" = "-f" ] && printf '%s\n' "${DOCKER_NET_DESC:-}"
				exit 0
				;;
		esac
		;;
esac
exit 0
