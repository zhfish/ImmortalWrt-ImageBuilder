#!/bin/sh
# 首次启动：系统默认设置（只在未初始化时执行，保留配置升级后不会覆盖你的修改）
. "${CUSTOM_LIBDIR:-/usr/lib/custom}/lib.sh"
custom_is_provisioned && exit 0

SSHD_CONFIG=${SSHD_CONFIG:-/etc/ssh/sshd_config}

# 默认主题 argon
uci -q set luci.main.mediaurlbase=/luci-static/argon
uci commit luci

# apk 软件源镜像：ImmortalWrt 自带的 99-default-settings-chinese 会读取这一项，
# 把 distfeeds.list 中的 downloads.immortalwrt.org 替换掉（升级固件后也会自动重新应用）
uci -q get system.@imm_init[0] >/dev/null || uci -q add system imm_init >/dev/null
uci -q set system.@imm_init[0].apk_mirror=https://mirrors.cernet.edu.cn/immortalwrt
uci commit system

# UPnP 默认关闭；服务本身保持启用，在 LuCI 中勾选“启用”即可开启
uci -q set upnpd.config.enabled=0
uci commit upnpd

# 流量卸载：kmod 已安装，但默认不启用
uci -q set firewall.@defaults[0].flow_offloading=0
uci -q set firewall.@defaults[0].flow_offloading_hw=0
uci commit firewall

# sshd：允许 root 用密码登录（需先在 LuCI 设置 root 密码，空密码仍会被拒绝）。
# 替换第一处 PermitRootLogin（含注释掉的），删除其余；没有则追加
if [ -f "$SSHD_CONFIG" ]; then
	awk '
		/^#?PermitRootLogin/ { if (!done) print "PermitRootLogin yes"; done = 1; next }
		{ print }
		END { if (!done) print "PermitRootLogin yes" }' "$SSHD_CONFIG" > "$SSHD_CONFIG.tmp" &&
		cat "$SSHD_CONFIG.tmp" > "$SSHD_CONFIG"
	rm -f "$SSHD_CONFIG.tmp"
fi

custom_log "system: argon theme, cernet apk mirror, upnp off, flow offloading off, sshd root login"
exit 0
