#!/bin/sh /etc/rc.common
# DPanel Docker 管理面板：http://路由器地址:8086，数据在 /data/dpanel。
# 在 dockerd 之后启动（同为 S99，按名称排序），在 dockerd 之前停止。
USE_PROCD=1
START=99
STOP=05

start_service() {
	# DPANEL_VERSION 由构建时写入
	[ -f /etc/custom/build.conf ] && . /etc/custom/build.conf
	mkdir -p /data/dpanel
	procd_open_instance
	procd_set_param command /usr/bin/dpanel server:start -f /etc/dpanel/config.yaml
	procd_set_param env \
		APP_NAME=dpanel \
		APP_VERSION="${DPANEL_VERSION:-}" \
		APP_SERVER_PORT=8086 \
		DP_SYSTEM_STORAGE_LOCAL_PATH=/data/dpanel \
		DP_RUN_IN_CONTAINER=0 \
		DP_LOG_CONSOLE_LEVEL=info
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
