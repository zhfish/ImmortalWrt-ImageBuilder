#!/bin/sh /etc/rc.common
# Docker 守护进程（Docker 官方静态二进制），配置文件 /etc/docker/daemon.json。
# Docker 随固件一起升级：重新构建固件即可，apk upgrade 不会改动它。
USE_PROCD=1
START=99
STOP=10

start_service() {
	nofile=$(cat /proc/sys/fs/nr_open)
	procd_open_instance
	procd_set_param command /usr/bin/dockerd --config-file=/etc/docker/daemon.json
	procd_set_param limits nofile="$nofile $nofile"
	procd_set_param respawn
	# 给容器留出正常退出的时间，超时后才强制结束
	procd_set_param term_timeout 60
	procd_set_param stderr 1
	procd_close_instance
}
